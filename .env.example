# ==============================================================================
# SentinelX environment configuration
# Copy this file to .env and fill in values for local development.
# Defaults below are safe for a fully local, mock-mode demo.
# ==============================================================================

# ---- General ----
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=SentinelX

# ---- Database ----
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx_dev_password
POSTGRES_DB=sentinelx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sentinelx:sentinelx_dev_password@postgres:5432/sentinelx

# ---- pgcrypto ----
# Symmetric key used to encrypt sensitive finding columns via pgcrypto.
# Generate a real value for anything beyond local dev, for example: openssl rand -hex 32
PGCRYPTO_KEY=dev_only_pgcrypto_key_do_not_use_in_prod

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Auth / JWT ----
# Generate a real secret for anything beyond local dev, for example: openssl rand -hex 32
JWT_SECRET_KEY=dev_only_jwt_secret_do_not_use_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Scanner Adapters ----
# Options: mock | real
SCANNER_MODE=mock
NUCLEI_BINARY_PATH=/usr/local/bin/nuclei
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=changeme
NMAP_BINARY_PATH=/usr/bin/nmap
SCANNER_TIMEOUT_SECONDS=120
SCANNER_MAX_RETRIES=2

# Mock scanner only. Fixes a ticket needs before the mock scanner stops
# reporting its endpoint. 1 = first fix passes verification.
# 2 = first fix fails (ticket reopens), second fix passes. Good for demos.
MOCK_FIXES_REQUIRED=1

# ---- LLM Providers ----
# Options: mock | self_hosted | claude
# Early agents (Recon, Mapping, Assessment, Validation) must NOT use `claude`.
EARLY_AGENT_LLM_MODE=mock
LATE_AGENT_LLM_MODE=mock

SELF_HOSTED_LLM_BASE_URL=http://vllm:8000/v1
SELF_HOSTED_LLM_MODEL_NAME=Qwen2.5-7B-Instruct
SELF_HOSTED_LLM_API_KEY=not_required_locally

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-4-6

LLM_REQUEST_TIMEOUT_SECONDS=60

# ---- Notifications ----
# Options: dev_console | smtp | sms_push
NOTIFICATION_MODE=dev_console

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alerts@sentinelx.local
SMTP_USE_TLS=true

SMS_PUSH_PROVIDER_API_URL=
SMS_PUSH_PROVIDER_API_KEY=

# ---- SLA defaults (days), used to seed the department SLA config ----
SLA_CRITICAL_DAYS=3
SLA_HIGH_DAYS=7
SLA_MEDIUM_DAYS=15
SLA_LOW_DAYS=30

# ---- Target safety ----
# Comma-separated list of domain suffixes treated as requiring a stored
# written authorization record before any scan is permitted.
RESTRICTED_DOMAIN_SUFFIXES=.gov.in

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1